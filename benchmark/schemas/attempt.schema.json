{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vitalNohj/blender-axi/benchmark/schemas/attempt.schema.json",
  "title": "Blender benchmark attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "run_id", "pair_id", "task_id", "task_category", "capability_scope", "replicate", "arm", "randomization", "validity", "versions", "inputs", "cache", "usage", "trajectory", "timing", "outcome", "scores", "artifacts", "oracles", "environment", "notes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"const": "blender-axi-vs-blendermcp-1"},
    "run_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "task_id": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6"]},
    "task_category": {"type": "string"},
    "capability_scope": {"enum": ["shared", "exclusive"]},
    "replicate": {"type": "integer", "minimum": 1},
    "arm": {"enum": ["axi", "mcp"]},
    "randomization": {"type": "object"},
    "validity": {"type": "object", "required": ["status", "invalid_reason", "replacement_for", "replacement_run_id", "policy_violation"]},
    "versions": {"type": "object"},
    "inputs": {"type": "object"},
    "cache": {"type": "object"},
    "usage": {"type": "object"},
    "trajectory": {"type": "object"},
    "timing": {"type": "object"},
    "outcome": {"type": "object"},
    "scores": {"type": "object"},
    "artifacts": {"type": "array"},
    "oracles": {"type": "object"},
    "environment": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
