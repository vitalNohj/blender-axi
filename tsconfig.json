{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "benchmark/bin/**/*.ts", "benchmark/src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "benchmark/**/*.test.ts"]
}
